-- ================================ 主循环 ================================
local function UpdateMainLogic()
    UpdateGiantIdlePenalty()
    if Config.AimbotEnabled then StartAimbot() else StopAimbot() end
    if Config.NoRecoilEnabled then StartRecoil() else StopRecoil() end
    UpdateAPCHighlight()

    -- ESP高亮
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not IsPlayerAlive(player) then
            pcall(function() if player.Character and player.Character:FindFirstChild("DetectorHighlight") then player.Character.DetectorHighlight:Destroy() end end)
            continue
        end
        local role, weapon = GetPlayerRoleAndWeapon(player)
        local roleInfo = Config.RoleConfig[role]
        local shouldHighlight = (Config.HighlightDanger and roleInfo.IsDanger) or (Config.HighlightSheriff and role == "Sheriff") or (Config.HighlightInnocent and role == "Innocent")
        if shouldHighlight then
            pcall(function()
                local char = player.Character
                if char then
                    local hl = char:FindFirstChild("DetectorHighlight") or Instance.new("Highlight", char)
                    hl.Name = "DetectorHighlight"; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.FillTransparency = 0.7; hl.OutlineTransparency = 0
                    hl.OutlineColor = roleInfo.Color; hl.FillColor = roleInfo.Color; hl.Enabled = true
                end
            end)
        else
            pcall(function() if player.Character and player.Character:FindFirstChild("DetectorHighlight") then player.Character.DetectorHighlight:Destroy() end end)
        end
        -- 杀手警告
        if role == "Killer" and Config.WarnWhenKillerNear and GetPlayerDistance(player) <= Config.WarnDistance then
            if not IsWarned then
                IsWarned = true
                Services.StarterGui:SetCore("SendNotification", { Title = "⚠️ 危险预警", Text = "杀手正在靠近你！", Duration = 3 })
            end
        end
    end
    -- 重置警告
    local killerNear = false
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LocalPlayer and IsPlayerAlive(player) then
            if GetPlayerRoleAndWeapon(player) == "Killer" and GetPlayerDistance(player) <= Config.WarnDistance then killerNear = true; break end
        end
    end
    if not killerNear then IsWarned = false end
end

Services.RunService.Heartbeat:Connect(function() pcall(UpdateMainLogic) end)

