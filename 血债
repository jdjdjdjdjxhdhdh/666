    end
    confirmBtn.MouseButton1Click:Connect(tryVerify)
    inputBox.FocusLost:Connect(function(ep) if ep then tryVerify() end end)
    task.wait(0.1); pcall(function() inputBox:CaptureFocus() end)
    repeat task.wait(0.1) until done
