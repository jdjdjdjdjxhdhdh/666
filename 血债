local function FireExtraBullets()
    if not Config.BulletIncreaserEnabled or Config.ExtraBulletsCount <= 0 then return end
    local char = LocalPlayer.Character; if not char then return end
    local tool = char:FindFirstChildOfClass("Tool"); if not tool then return end
    local damage = 10
    local head = char:FindFirstChild("Head"); local origin = head and head.Position or Camera.CFrame.Position
    for i = 1, Config.ExtraBulletsCount do
        local direction = (Camera.CFrame.LookVector + Vector3.new(math.random(-50,50)/1000, math.random(-50,50)/1000, math.random(-50,50)/1000)).Unit
        local ray = Ray.new(origin, direction * 500)
        local hit = workspace:FindPartOnRayWithIgnoreList(ray, {char})
        if hit then
            local model = hit:FindFirstAncestorOfClass("Model")
            if model then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    humanoid:TakeDamage(damage)
                    CreateDamageDisplay(model, damage)
                end
            end
        end
    end
end

local function SetupGlobalToolListener()
    if not LocalPlayer.Character then return end
    for _, tool in pairs(LocalPlayer.Character:GetChildren()) do
        if tool:IsA("Tool") then
            if not tool:GetAttribute("RecoilTracked") then
                tool:SetAttribute("RecoilTracked", true); table.insert(Connections, tool.Activated:Connect(OnToolActivated))
            end
            if not tool:GetAttribute("ExtraBulletTracked") then
                tool:SetAttribute("ExtraBulletTracked", true); table.insert(Connections, tool.Activated:Connect(FireExtraBullets))
            end
        end
    end
end
